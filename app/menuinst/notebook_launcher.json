{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "VLab4Mic",
  "menu_items": [
    {
      "name": "VLab4Mic",
      "description": "Launch VLab4Mic in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/VLab4Mic/launch_jupyter.py",
        "{{ PREFIX }}/VLab4Mic/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "BASE_PATH_KEYWORD/VLab4Mic/20260602_vlab4mic_fig2_NPC.ico"
        },
        "linux": {
          "icon": "BASE_PATH_KEYWORD/VLab4Mic/20260602_vlab4mic_fig2_NPC.png"
        },
        "osx": {
          "icon": "BASE_PATH_KEYWORD/VLab4Mic/20260602_vlab4mic_fig2_NPC.icns"
        }
      }
    }
  ]
}
